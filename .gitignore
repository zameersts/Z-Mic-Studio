# Android / Gradle
.gradle/
build/
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
local.properties
*.apk
*.aab

# Release signing. Losing the keystore means no future release can update an
# installed app, so these must never reach the repository in any form.
keystore.properties
*.jks
*.keystore
*.p12
*.pem
*.key
*passwords*.txt
android/keystore.properties

# R8 obfuscation mapping. It maps the obfuscated names back to the real ones, so it
# is as sensitive as the keystore and is needed to debug a release crash.
android/app/mapping.txt
android/app/resources.txt
android/app/*/mapping.txt

# Python
__pycache__/
*.py[cod]
*$py.class
windows/__pycache__/
*.egg-info/
.pytest_cache/

# Logs
*.log
windows/*.log

# C++ Build outputs
windows/build/
windows/bin/
*.obj
*.exe
*.pdb
*.ilk

# OS files
.DS_Store
Thumbs.db
