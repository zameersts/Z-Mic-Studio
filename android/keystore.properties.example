# Z Mic Studio - Release Signing Configuration Example
#
# To sign production APKs with your own release key:
# 1. Copy this file to: android/keystore.properties
# 2. Update the values below to match your actual keystore credentials.
#
# NOTE: Never commit keystore.properties or keystore files (.jks) to version control.
# If keystore.properties is missing, the build will automatically use the debug key.

storeFile=/path/to/your/zmic-release.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
