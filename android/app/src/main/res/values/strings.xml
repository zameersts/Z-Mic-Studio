    <!-- Welcome Onboarding Screen -->
    <string name="welcome_title">Z Mic Studio</string>
    <string name="welcome_subtitle">Virtual Studio Microphone</string>
    <string name="welcome_description">Z Mic Studio turns your smartphone into a studio-grade virtual microphone for your Windows PC. Created by Zameer. Enjoy crystal clear dual-mic stereo sound with screen reader accessibility.</string>
    <string name="welcome_permission_title">Permissions Needed</string>
    <string name="welcome_permission_note">Microphone and Notification permissions are required to stream audio and receive connection requests from your PC.</string>
    <string name="welcome_permissions_granted">Permissions granted. Press Continue to open Z Mic Studio.</string>
    <string name="welcome_permissions_pending">Permission status: not checked yet.</string>
    <string name="welcome_btn_continue">Continue</string>
    <string name="welcome_btn_open_settings">Open App Settings</string>

    <!-- Terms and Privacy (wording itself lives in Terms.kt so it matches the PC app) -->
    <string name="welcome_terms_heading">Terms and Privacy</string>
    <string name="welcome_terms_intro">Please read the Terms and Privacy below. Tick the box to agree, then press Continue.</string>
    <string name="dialog_view_terms_title">Terms and Privacy</string>

    <!-- Permission dialog -->
    <string name="dialog_permission_title">Microphone Permission Needed</string>
    <string name="dialog_permission_message">Z Mic Studio cannot stream audio without the microphone permission. Because it was denied permanently, Android will not ask again. Open App Settings, choose Permissions, and enable Microphone.</string>
    <string name="btn_open_settings">Open App Settings</string>
    <string name="btn_close">Close</string>

