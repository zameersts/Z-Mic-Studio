<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    android:accessibilityPaneTitle="@string/welcome_title"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:accessibilityHeading="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_subtitle"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:accessibilityHeading="true"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/tvWelcomeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_description"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvWelcomeTermsHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_terms_heading"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:accessibilityHeading="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvWelcomeTermsAnnounce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/welcome_terms_intro"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Read only terms text. Filled in from Terms.kt so the wording matches the PC app. -->
        <ScrollView
            android:id="@+id/termsScroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtWelcomeTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary" />
        </ScrollView>

        <CheckBox
            android:id="@+id/chkWelcomeAgree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:screenReaderFocusable="false"
            android:importantForAccessibility="no">

            <TextView
                android:id="@+id/tvPermissionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_permission_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:accessibilityHeading="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPermissionNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_permission_note"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary" />

            <!-- Live region: permission grant/denial is spoken as it changes. -->
            <TextView
                android:id="@+id/tvPermissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_permissions_pending"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/error"
                android:accessibilityLiveRegion="polite"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWelcomeOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/welcome_btn_open_settings"
            android:textSize="16sp"
            android:contentDescription="@string/cd_open_settings"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <View
            android:id="@+id/spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <Button
            android:id="@+id/btnWelcomeContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/welcome_btn_continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="@string/cd_continue"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
